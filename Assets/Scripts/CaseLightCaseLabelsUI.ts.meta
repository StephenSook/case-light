    - '// @input string captionText = "Practice mail, real house numbers" {"hint":"Caption that says what the letters are (the small print under it says it is not a USPS route and credits OpenStreetMap)"}'
    - '// @input string resultTemplate = "From memory: {x} of {y} this session" {"hint":"End-of-recall card text; {x} = letters placed from memory (helped letters never count), {y} = letters placed. The earlier wording was \"Unaided: {x}/{y} this session\""}'
