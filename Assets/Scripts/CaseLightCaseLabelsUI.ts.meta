    - "// @input float streetNameRepeatCells = 8 {\"hint\":\"Repeat each street's name along its block every this many cells (smaller than the name at the block start), so a turned view still shows a street name\", \"widget\":\"slider\", \"min\":6, \"max\":12, \"step\":1}"
    - '// @ui {"widget":"group_end"}'
