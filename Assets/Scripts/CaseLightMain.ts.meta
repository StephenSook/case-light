  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CaseLightMain - practice / recall drill at a real-size case</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject caseRoot {"hint":"Case root: the world-fixed practice case (move this to move the case, tray and buttons)"}'
    - '// @input AssignableType_1 caseMesh {"hint":"Case line art (MeshBuilder)"}'
    - '// @input AssignableType_2 caseLabels {"hint":"Label strips, caption and session result text"}'
    - '// @input AssignableType_3 highlights {"hint":"Answer glow and snap outline"}'
    - '// @input AssignableType_4 bundle {"hint":"Bundle tray and sample letters"}'
    - '// @input AssignableType_5 controls {"hint":"Start practice / Start recall buttons"}'
    - '// @input AssignableType_6 viewCue {"hint":"Display rectangle and edge arrow"}'
    - '// @input AssignableType_7 ripples {"hint":"Ring ripple where a pinch lands and where a letter snaps in (optional)"}'
    - '// @input AssignableType_8 sounds {"hint":"Chime on a right drop, low tone on a miss, played from the cell they refer to (optional)"}'
    - '// @input AssignableType_9 pace {"hint":"Optional drill pace light, switched by the Drill pace toggle (off by default)"}'
    - '// @input AssignableType_10 exitControls {"hint":"Again / Done buttons shown with the score card at the end of a recall pass"}'
    - '// @input AssignableType_11 mixUps {"hint":"Mix-up lines drawn on the score view after a recall pass (needs mixUpLines on)"}'
    - '// @input AssignableType_12 placement {"hint":"Optional: put the case on a real wall (Place on wall / Place in front of me). Nothing moves unless the user asks"}'
    - '// @input AssignableType_13 veteran {"hint":"Optional: Veteran mode, where a veteran pins sorting reminders on slots (letters pause while it is on)"}'
    - "// @input AssignableType_14 routePicker {\"hint\":\"Optional: today's route choice (Route 1 | Route 2), usable only between passes\"}"
    - '// @input Asset.Material lineMaterial {"hint":"Unlit vertex-colour material used for all line art (SimpleVertexBaseColor)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float shelfCount = 6 {"hint":"Total shelves in the case (two are playable; the rest are faint outlines). A standard city case has 6.", "widget":"slider", "min":4, "max":8, "step":1}'
    - '// @input float bundleCount = 8 {"hint":"Pieces in the sample bundle (always includes the hold piece)", "widget":"slider", "min":2, "max":12, "step":1}'
    - '// @input float resultSeconds = 5 {"hint":"Seconds the end-of-recall result stays on the case", "widget":"slider", "min":1, "max":20, "step":0.5}'
    - "// @input bool practiceLadder {\"hint\":\"Practice cue ladder: each address's practice cue fades a rung after a right placement (slot, then row, then shelf band) and comes back a rung after a miss. Off = the exact separation glows on every practice pass\"}"
    - "// @input bool mixUpLines = true {\"hint\":\"After a recall pass, draw a thin line from each missed address's wrong cell to its right cell, outline both cells and label them (cleared by Again, Done or any Start)\"}"
    - '// @input float startGuardSeconds = 0.6 {"hint":"A Start button press this soon after Again or Done is ignored, so one pinch can never press an exit button and then a Start button (0 = off)", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Demo</span>"}'
    - '// @ui {"widget":"group_start", "label":"Demo"}'
    - "// @input bool demoReplay {\"hint\":\"Demo replay (off for every normal session; never save it on): at Lens start, replays one recorded real run (data/demo_replay_s1-g3nddr.log, a LEAF run with real SIK input in the preview) through the same handlers a hand reaches, under a 'Demo replay' label, and stops on any result that differs from the recording\"}"
    - '// @ui {"widget":"group_end"}'
