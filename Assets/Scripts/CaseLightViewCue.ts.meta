    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input float displayWidthDeg = 23.6 {\"hint\":\"Width of the glasses' display in degrees (Snap's table: about 23.6 at 55 cm; hackathon guide: about 32)\", \"widget\":\"slider\", \"min\":15, \"max\":50, \"step\":0.1}"
