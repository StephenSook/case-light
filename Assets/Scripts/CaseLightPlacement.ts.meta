  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CaseLightPlacement - put the case on a real wall (opt-in)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject caseRoot {"hint":"The case group that moves as one rigid body (case, labels, tray, buttons, caption)"}'
    - '// @input AssignableType_1 controls {"hint":"Place on wall / Place in front of me controls and the refuse cue"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float maxWallTiltDeg = 30 {"hint":"A surface more than this many degrees from vertical is not a wall (floor, table, ceiling): the placement is refused", "widget":"slider", "min":5, "max":60, "step":1}'
    - "// @input float minWallDistanceCm = 50 {\"hint\":\"A wall closer than this to the eye is refused (cm). Snap's guidance: keep content about 0.5 to 3 m away\", \"widget\":\"slider\", \"min\":20, \"max\":100, \"step\":5}"
    - "// @input float maxWallDistanceCm = 300 {\"hint\":\"A wall farther than this from the eye is refused (cm); the case is for arm's reach. Snap's guidance: about 0.5 to 3 m\", \"widget\":\"slider\", \"min\":100, \"max\":500, \"step\":10}"
    - "// @input float wallGapCm {\"hint\":\"Gap between the wall and the case face, in cm (0 = the face on the wall; 30 = the case's back on the wall)\", \"widget\":\"slider\", \"min\":0, \"max\":40, \"step\":1}"
    - '// @input vec4 aimColor = "{0.55,0.9,1,1}" {"hint":"Colour of the case outline shown on the wall while aiming", "widget":"color"}'
    - '// @input vec4 refuseColor = "{1,0.72,0.3,1}" {"hint":"Colour of the ring and cue shown where the case cannot go", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
