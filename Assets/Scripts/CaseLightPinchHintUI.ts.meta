  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CaseLightPinchHintUI - opening pinch hint at the top letter</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input AssignableType_1 hint {\"hint\":\"The 3D Hints package's controller (the PinchHint object under this anchor; its Auto Play stays off)\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input vec3 pinchSpotCm = \"{4,-2,0.8}\" {\"hint\":\"Where the hand pinches the top letter, in the letter's own frame (cm): right of the address, just off the letter's face so the fingertips show\"}"
    - '// @input float handScale = 0.35 {"hint":"Size of the hint hand (1 = life size at the letter). 0.35 keeps the whole hand, forearm included, clear of the caption, version tag, start hint and buttons; re-run extra-pinch-hint after any change", "widget":"slider", "min":0.2, "max":1, "step":0.01}'
    - "// @input float rollDeg = -45 {\"hint\":\"Turn of the hand about the eye's line to the pinch spot, in degrees (negative turns it counterclockwise as seen, so the arm comes in from the right)\", \"widget\":\"slider\", \"min\":-180, \"max\":180, \"step\":1}"
    - '// @input float swingDeg = 30 {"hint":"Turn of the hand about the vertical through the pinch spot, in degrees (positive swings the forearm to the right, so it shows foreshortened)", "widget":"slider", "min":-90, "max":90, "step":1}'
    - "// @input float speed = 1 {\"hint\":\"Speed of the pinch animation (1 = the package's own speed)\", \"widget\":\"slider\", \"min\":0.5, \"max\":2, \"step\":0.05}"
    - '// @ui {"widget":"group_end"}'
