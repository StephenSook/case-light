        ScriptName:
          String: cellAspect
        SortIndex:
          Variable: 3
        Step:
          Variable: 0.01
        Title:
          String: Cell Aspect
        Tooltip:
          String: "Height / width of the glowing quad, so the soft rim has the same width on every side"
      PositionX: -360
      PositionY: 380
      TemplateID: nodes_inputs_parameters_float
      Title1: Float Parameter
      Title2: Cell Aspect
    Node4:
      DependencyIndex: 4
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 glowColor;
            input_float pulseHz;
            input_float pulseAmount;
            input_float cellAspect;
            output_vec4 result;

            void main()
            {
            	vec2 uv = system.getSurfaceUVCoord0();
            	// Distance to the nearest edge, in cell widths (x spans 1, y spans cellAspect).
            	float dx = min(uv.x, 1.0 - uv.x);
            	float dy = min(uv.y, 1.0 - uv.y) * cellAspect;
            	float d = min(dx, dy);
            	// Bright soft rim easing into a lighter fill; the minimum stays well above black.
            	float rim = 1.0 - smoothstep(0.0, 0.32, d);
            	float level = mix(0.45, 1.0, rim);
            	float t = system.getTimeElapsed();
            	float pulse = 1.0 - pulseAmount * 0.5 * (1.0 - cos(6.2831853 * pulseHz * t));
            	result = vec4(glowColor.rgb * level * pulse, 1.0);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Cell Glow
        UseExternalFile:
          Variable: false
        cellAspect:
          Connection0:
            NodeLevelID: 7
            PortID: Output
          Variable: 0.0
        glowColor:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        ngs_Height:
          Variable: 420
        ngs_Version:
          String: 0.1.0
        pulseAmount:
          Connection0:
            NodeLevelID: 6
            PortID: Output
          Variable: 0.0
        pulseHz:
          Connection0:
            NodeLevelID: 5
            PortID: Output
          Variable: 0.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -40
      PositionY: 120
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Cell Glow
